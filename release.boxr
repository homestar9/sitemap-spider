# release.boxr — build and publish sitemap-spider to ForgeBox.
#
# Run from the repo root:  box recipe release.boxr
# (or the box.json shortcut: box run-script release)
#
# Bump the box.json version and roll the changelog BEFORE running this — see the
# "Releasing" section in readme.md for the full checklist.
#
# build:module stamps the real version into ModuleConfig.cfc's this.version and
# leaves the clean, exclude-filtered package under .tmp/sitemap-spider. Publishing
# from there is what ships the stamped version; publishing the repo root would
# ship the @build.version@ placeholder instead.
run-script build:module
cd .tmp/sitemap-spider
publish
cd ../..
